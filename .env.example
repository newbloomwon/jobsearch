# ---- JobSearch Engine environment ----
# Copy to .env and fill in what you have. Everything is optional:
# with no keys the app still runs (JobSpy scrapers + sample data),
# and each unconfigured provider is simply reported as such.

# --- Adzuna (official free-tier jobs API — https://developer.adzuna.com) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Jooble (official free jobs API — https://jooble.org/api/about) ---
JOOBLE_API_KEY=

# --- Handshake (no public API; requires a logged-in student session) ---
# School subdomain, e.g. "usf" for usf.joinhandshake.com
HANDSHAKE_SCHOOL=
# Full Cookie header copied from a logged-in browser session on that subdomain
HANDSHAKE_COOKIE=

# --- JobSpy scrapers (LinkedIn / Indeed / Glassdoor / ZipRecruiter) ---
# Optional authenticated proxies to avoid rate limits, e.g. "user:pass@host:port"
JOBSPY_PROXIES=
# Set to 0 to disable scraped providers entirely
JOBSPY_ENABLED=1

# --- Engine/API behaviour ---
# Always expose the offline sample provider in /api/providers (0/1)
JOBSEARCH_SAMPLE=0
# Comma-separated CORS origins for the API (default: *)
JOBSEARCH_ALLOWED_ORIGINS=*
# Per-provider timeout in seconds (scrapes can take ~30-60s)
JOBSEARCH_PROVIDER_TIMEOUT=60
# Hours an uploaded resume stays in memory
JOBSEARCH_RESUME_TTL_HOURS=24
PORT=8000
